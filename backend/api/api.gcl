@volatile
type NetworkNodeItem {
    id: String;
    label: String;
    group: String;
    gcNode: node<any>?;
    data: any?;
}

@volatile
type NetworkEdgeItem {
    id: String;
    from: String;
    to: String;
    length: int;
}

@volatile
type NetworkSnapshot {
    nodes: Array<NetworkNodeItem>;
    edges: Array<NetworkEdgeItem>;
}

@expose
fn graphSnapshot(t: time?): NetworkSnapshot {
    var rand = Random{};
    var nodes = Array<NetworkNodeItem> {};
    var edges = Array<NetworkEdgeItem> {};

    for (id, nCu in nrCellCU_by_nRCellId) {
        nodes.add(NetworkNodeItem { id: "${nCu->nRCellId}", group: "CellCU", label: "CU: ${nCu->nRCellId}", gcNode: nCu, data: *nCu });

        for (_, nDu in nCu->nrCellDU_by_duId) {
            nodes.add(NetworkNodeItem { id: "${nDu->physicalCellId}", group: "CellDU", label: "DU: ${nCu->physicalCellId}", gcNode: nDu, data: *nDu });
            edges.add(NetworkEdgeItem { id: "${nCu->nRCellId}-${nDu->physicalCellId}", from: "${nCu->nRCellId}", to: "${nDu->physicalCellId}", length: 300 });

            //BWP
            nodes.add(NetworkNodeItem { id: "${nDu->physicalCellId}_bwp", group: "BWP", label: "RBs:${nDu->bwp.numberOfRBs} Sub.Car.Spac.:${nDu->bwp.subCarrierSpacing}" });
            edges.add(NetworkEdgeItem { id: "${nDu->physicalCellId}-${nDu->physicalCellId}_bwp", from: "${nDu->physicalCellId}", to: "${nDu->physicalCellId}_bwp", length: 100 });

            var snapTime = t;

            for (_, nUE in nDu->userEquipments) {
                if(nUE->connected == false && rand.uniformf(0.0,1.0)<0.1) {
                    nUE->connected = true;
                } else if(rand.uniformf(0.0,1.0)<0.05) {
                    nUE->connected = false;
                }

                if(nUE->connected == false) {
                    continue;
                }

                if (snapTime == null) {
                    snapTime = nUE->synchronizationSignal.lastTime();
                }
                var nUE_id = "${nDu->physicalCellId}_${nUE->id}";
                var signal = nUE->synchronizationSignal.resolveAtWithin(snapTime!!, 1_min);
                if (signal != null) {
                    nodes.add(NetworkNodeItem { id: "${nUE_id}", group: "UE", label: "UE: ${nUE->id}", gcNode: nUE, data: *nUE }); // SINR: ${signal.sinr}"});
                    edges.add(NetworkEdgeItem { id: "${nDu->physicalCellId}-${nUE_id}", from: "${nDu->physicalCellId}", to: "${nUE_id}", length: 100 });

                    //SyncSign
                    nodes.add(
                        NetworkNodeItem {
                            id: "${nUE_id}_sync",
                            group: "Sync",
                            label: "Sync SINR:${signal.sinr} RSRP: ${signal.rsrp} RSRQ: ${signal.rsrq}",
                            data: signal
                        }
                    );
                    edges.add(NetworkEdgeItem { id: "${nUE_id}-${nUE_id}_sync", from: "${nUE_id}", to: "${nUE_id}_sync", length: 200 });
                }
            }
        }
    }
    return NetworkSnapshot {
        nodes: nodes,
        edges: edges,
    };
}

@volatile
type SignalRecord {
    t: time;
    rsrp: int;
    rsrq: float;
    sinr: float;
}

@expose
fn getSignal(nUE: node<UE>): Table<SignalRecord>? {
    var ue = *nUE;
    if(ue == null || !(ue is UE)) {
        return null;
    }
    
    var res = Table<SignalRecord>{};
    for(t, v in ue.synchronizationSignal) {
        res.add_row(SignalRecord{
            t: t,
            rsrp: v.rsrp,
            rsrq: v.rsrq,
            sinr: v.sinr,
        });
    }
    return res;
}

@expose
fn ueSignal(ueId: String, t: time): float {
